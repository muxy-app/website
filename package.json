{
  "name": "muxy-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build-themes": "node scripts/build-themes.mjs",
    "docs:pull": "node scripts/pull-docs.mjs",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:build": "npm run docs:pull && npm run docs:generate",
    "docs:refresh": "npm run docs:build",
    "predev": "npm run build-themes && node scripts/generate-docs.mjs --ensure-cache",
    "prebuild": "npm run build-themes && npm run docs:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.15.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.2"
  }
}
